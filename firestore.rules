rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidReferenceDocument(data) {
      return data.referenceDocumentId is string &&
             data.referenceDocumentId.size() > 0 &&
             data.referenceDocumentId.size() <= 128 &&
             data.documentType is string &&
             data.documentType in ['PASSPORT', 'VISA', 'NATIONAL_ID', 'DRIVING_LICENSE', 'PERMIT', 'TRAVEL_AUTHORIZATION', 'UNKNOWN'] &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 200 &&
             data.imageUrl is string &&
             data.imageUrl.size() > 0 &&
             data.imageUrl.size() <= 2048 &&
             data.extractedText is string &&
             data.extractedText.size() <= 10000 &&
             data.imageHash is string &&
             data.imageHash.size() > 0 &&
             data.imageHash.size() <= 128 &&
             data.sourceType is string &&
             data.sourceType.size() <= 64 &&
             data.verificationMode is string &&
             data.verificationMode.size() <= 64;
    }

    function isValidScreeningRecord(data) {
      return data.caseId is string &&
             data.caseId.size() > 0 &&
             data.caseId.size() <= 128 &&
             data.aiScore is number &&
             data.riskScore is number &&
             data.riskLevel is string &&
             data.riskLevel in ['low', 'moderate_low', 'medium', 'high', 'critical'] &&
             data.status is string &&
             data.status in ['verified', 'suspicious', 'rejected', 'manual_review'];
    }

    function isValidReport(data) {
      return data.reportId is string &&
             data.reportId.size() > 0 &&
             data.caseId is string &&
             data.caseId.size() > 0 &&
             data.digitalSignature is string;
    }

    function isValidAuditLog(data) {
      return data.logId is string &&
             data.logId.size() > 0 &&
             data.action is string &&
             data.timestamp is string &&
             data.severity in ['info', 'warning', 'critical'];
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reference Documents Collection:
    // Demo Reference Database records for border checkpoint comparison
    match /referenceDocuments/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId) && isValidReferenceDocument(incoming());
      allow delete: if false;
    }

    // Screening Records Collection:
    // Read and Write for officer screenings and AI evaluations
    match /screeningRecords/{caseId} {
      allow get, list: if true;
      allow create, update: if isValidId(caseId) && isValidScreeningRecord(incoming());
      allow delete: if false;
    }

    // Official Reports Collection:
    match /reports/{reportId} {
      allow get, list: if true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update: if isValidId(reportId) && isValidReport(incoming());
      allow delete: if false;
    }

    // Audit Logs Collection:
    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false; // Immutable audit log
    }
  }
}
